# ==============================================================================
# SecureDeploy — Environment Configuration Template
# NOTE: This file contains template placeholders only. NEVER commit real secrets.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=your-secure-random-session-secret-at-least-32-chars

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securedeploy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securedeploy?schema=public

# ------------------------------------------------------------------------------
# GitHub App Integration Configuration
# ------------------------------------------------------------------------------
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Path to downloaded private key PEM file (recommended) OR raw PEM string
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Do NOT populate with real values)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1

