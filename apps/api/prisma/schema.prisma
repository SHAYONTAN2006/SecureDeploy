// Prisma schema for SecureDeploy
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  name           String?
  passwordHash   String?
  projects       Project[]
  installations  GithubInstallation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("users")
}

model Project {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String             @db.Uuid
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  repository  ProjectRepository?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
  @@map("projects")
}

model GithubInstallation {
  id                  String              @id @default(uuid()) @db.Uuid
  installationId      BigInt
  accountLogin        String
  accountId           BigInt
  accountType         String              @default("User")
  targetType          String?
  repositorySelection String?             @default("all")
  userId              String              @db.Uuid
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories        ProjectRepository[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([installationId, userId])
  @@index([userId])
  @@map("github_installations")
}

model ProjectRepository {
  id             String             @id @default(uuid()) @db.Uuid
  projectId      String             @unique @db.Uuid
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installationId String             @db.Uuid
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  repoId         BigInt
  repoOwner      String
  repoName       String
  fullName       String
  repoUrl        String
  defaultBranch  String             @default("main")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([installationId])
  @@index([repoId])
  @@map("project_repositories")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
